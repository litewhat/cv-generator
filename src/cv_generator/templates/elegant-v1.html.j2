<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <title>{{ name }} - {{ title }}</title>
  <style>
    /* elegant-v1 — ATS-safe single-column CV. Variables: name, title, email, phone_number, location, social_profiles, content. */
    :root {
      --ink: #1f2933;
      --body: #2c333a;
      --muted: #5c6770;
      --rule: #c5cdd4;
      --accent: #2f5d62;
      --paper: #ffffff;
    }

    @page {
      size: A4;
      margin: 1.8cm 1.8cm 2.0cm 1.8cm;
      @bottom-center {
        content: counter(page) " / " counter(pages);
        font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
        font-size: 7.5pt;
        color: #5c6770;
      }
    }

    * { orphans: 3; widows: 3; }

    html { -webkit-print-color-adjust: exact; print-color-adjust: exact; }

    body {
      font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
      font-size: 9.25pt;
      line-height: 1.5;
      color: var(--body);
      background: var(--paper);
      margin: 0;
      padding: 0;
      font-variant-ligatures: none;
      font-feature-settings: "liga" 0, "clig" 0;
      hyphens: none;
    }

    /* Masthead from required Content fields. */
    .cv-masthead {
      text-align: left;
      border-bottom: 0.75pt solid var(--rule);
      padding-bottom: 0.85em;
      margin-bottom: 1.25em;
    }
    .cv-masthead h1 {
      font-family: Palatino, "Palatino Linotype", "Book Antiqua", Georgia, serif;
      font-size: 22pt;
      font-weight: 700;
      letter-spacing: 0.01em;
      color: var(--ink);
      margin: 0 0 0.12em;
      line-height: 1.15;
    }
    .cv-masthead__role {
      font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
      font-size: 10pt;
      font-weight: 500;
      color: var(--muted);
      letter-spacing: 0.04em;
      margin: 0;
      line-height: 1.35;
    }
    .cv-masthead__contact,
    .cv-masthead__profiles {
      font-size: 9.25pt;
      color: var(--muted);
      margin: 0.4em 0 0;
      line-height: 1.45;
    }
    .cv-masthead__dot {
      color: var(--rule);
      margin: 0 0.4em;
    }
    .cv-masthead a {
      color: var(--accent);
      text-decoration: none;
      border-bottom: 0.4pt solid var(--rule);
    }

    /* Content: Markdown fragment. h1 = section, h2 = company, h3 = project. */
    .cv-content > h1:first-child { margin-top: 0; }

    .cv-content h1 {
      font-family: Palatino, "Palatino Linotype", "Book Antiqua", Georgia, serif;
      font-size: 13pt;
      font-weight: 600;
      color: var(--accent);
      letter-spacing: 0.02em;
      line-height: 1.25;
      border-left: 2.5pt solid var(--accent);
      padding-left: 0.55em;
      margin: 1.35em 0 0.5em;
      page-break-after: avoid;
    }

    .cv-content h2 {
      font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
      font-size: 11pt;
      font-weight: 600;
      color: var(--ink);
      margin: 1.15em 0 0.15em;
      line-height: 1.3;
      page-break-after: avoid;
    }

    .cv-content h3 {
      font-family: "Helvetica Neue", Helvetica, Arial, sans-serif;
      font-size: 10pt;
      font-weight: 600;
      color: var(--body);
      margin: 0.85em 0 0.15em;
      line-height: 1.35;
      page-break-after: avoid;
    }

    .cv-content h2 + p,
    .cv-content h3 + p,
    .cv-content h3 + ul { page-break-before: avoid; }

    .cv-content p {
      margin: 0.35em 0;
      line-height: 1.5;
    }

    .cv-content strong {
      font-weight: 600;
      color: var(--ink);
    }
    .cv-content p strong:first-child { color: var(--accent); }

    .cv-content ul,
    .cv-content ol {
      margin: 0.25em 0 0.65em;
      padding-left: 1.2em;
    }
    .cv-content__entry {
      page-break-inside: avoid;
      break-inside: avoid;
    }

    .cv-content li {
      margin: 0.18em 0;
      line-height: 1.5;
      page-break-inside: avoid;
    }
    .cv-content li::marker { color: var(--accent); }

    .cv-content a {
      color: var(--accent);
      text-decoration: none;
      border-bottom: 0.4pt solid var(--rule);
      word-break: break-word;
    }

    .cv-content hr {
      border: none;
      border-top: 0.75pt solid var(--rule);
      margin: 1.1em 0;
    }

    .cv-content table {
      border-collapse: collapse;
      width: 100%;
      margin: 0.7em 0;
      font-size: 8.7pt;
    }
    .cv-content th,
    .cv-content td {
      border: 0.6pt solid var(--rule);
      padding: 0.35em 0.55em;
      text-align: left;
      vertical-align: top;
    }

    .cv-content code {
      font-family: ui-monospace, "SF Mono", Menlo, Consolas, monospace;
      font-size: 0.88em;
    }
    .cv-content pre {
      background: #f7f8f8;
      border: 0.6pt solid var(--rule);
      padding: 0.7em 0.8em;
      overflow-x: auto;
      line-height: 1.45;
    }
  </style>
</head>
<body>
  <header class="cv-masthead">
    <h1>{{ name }}</h1>
    <p class="cv-masthead__role">{{ title }}</p>
    <p class="cv-masthead__contact">
      <a href="mailto:{{ email }}">{{ email }}</a><span class="cv-masthead__dot">·</span><span>{{ phone_number }}</span><span class="cv-masthead__dot">·</span><span>{{ location }}</span>
    </p>
    {% if social_profiles %}
    <p class="cv-masthead__profiles">
      {% for profile in social_profiles %}
        {% if not loop.first %}<span class="cv-masthead__dot">·</span>{% endif %}
        <a href="{{ profile.url }}">{{ profile.type }}</a>
      {% endfor %}
    </p>
    {% endif %}
  </header>
  <main class="cv-content">
    {{ content }}
  </main>
</body>
</html>
